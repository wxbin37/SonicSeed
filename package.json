{
  "name": "sonic-seed",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --dir frontend dev",
    "build": "CI=true pnpm --dir frontend build",
    "build:netlify": "CI=true pnpm --dir frontend build",
    "preview": "pnpm --dir frontend preview",
    "backend:dev": "cd backend && uvicorn app.main:app --reload --port 8000",
    "test": "CI=true pnpm run build && node --test tests/rendered-html.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
